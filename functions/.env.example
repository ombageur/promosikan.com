# Salin ke functions/.env.<project-id> (mis. functions/.env.promosikan-com). Bukan untuk secret.
# Secret (OPENAI_API_KEY, dll.) disimpan di Secret Manager: npx firebase functions:secrets:set NAMA

# URL frontend untuk link undangan anggota.
APP_URL=https://promosikan-com.web.app

# true = callable menolak request tanpa token App Check. Aktifkan setelah
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY terpasang di frontend.
ENFORCE_APP_CHECK=false
