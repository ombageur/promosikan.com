rules_version = '2';

// Security Rules Promosikan.com (SPEC §15).
// Matriks role dicerminkan dari shared/permissions.ts — ubah keduanya bersamaan;
// tests/rules memverifikasi keselarasannya.
// Admin SDK (Cloud Functions) tidak terikat rules ini.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identitas ----------
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // ---------- Keanggotaan & role ----------
    function memberPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid);
    }

    function isMember(wid) {
      return verified() && exists(memberPath(wid));
    }

    function roleIn(wid, roles) {
      return isMember(wid) && get(memberPath(wid)).data.role in roles;
    }

    // Cermin dari PERMISSIONS di shared/permissions.ts (hanya yang dipakai rules).
    function can(wid, permission) {
      return roleIn(wid, {
        'workspace.read': ['owner', 'admin', 'marketing', 'sales', 'viewer'],
        'workspace.update': ['owner', 'admin'],
        'members.manage': ['owner', 'admin'],
        'audit.read': ['owner', 'admin'],
        'catalog.manage': ['owner', 'admin', 'marketing'],
        'reply.edit': ['owner', 'admin', 'marketing', 'sales'],
        'automation.manage': ['owner', 'admin']
      }[permission]);
    }

    // ---------- Validasi ----------
    function optString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function reqString(data, field, min, max) {
      return field in data && data[field] is string && data[field].size() >= min && data[field].size() <= max;
    }

    function optStringOrNull(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function optList(data, field, max) {
      return !(field in data) || (data[field] is list && data[field].size() <= max);
    }

    function optIdOrNull(data, field) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= 128);
    }

    function optInt(data, field, min, max) {
      return !(field in data) || (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function optBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    // Jejak penulis untuk dokumen yang ditulis client.
    function stampedNow(data) {
      return data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function createdNow(data) {
      return data.createdAt == request.time && data.createdBy == request.auth.uid;
    }

    function createdUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // ---------- users/{uid} ----------
    function validUser(data) {
      return optString(data, 'displayName', 100)
        && optStringOrNull(data, 'photoURL', 2048)
        && optStringOrNull(data, 'lastWorkspaceId', 128)
        && (!('email' in data) || data.email == request.auth.token.email);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'lastWorkspaceId', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && validUser(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && changedOnly(['displayName', 'email', 'photoURL', 'lastWorkspaceId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validUser(request.resource.data);
      allow delete: if false;
    }

    // ---------- workspaces/{wid} ----------
    function validWorkspaceProfile(data) {
      return reqString(data, 'name', 2, 100)
        && reqString(data, 'businessName', 2, 100)
        && optString(data, 'industry', 100)
        && optString(data, 'website', 2048)
        && optString(data, 'description', 1000)
        && optString(data, 'location', 150)
        && optString(data, 'contactEmail', 254)
        && optString(data, 'contactPhone', 30)
        && optString(data, 'brandVoice', 200)
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['id', 'en'])
        && optStringOrNull(data, 'logoUrl', 2048)
        && (!('logoPath' in data) || data.logoPath == null
            || (data.logoPath is string && data.logoPath.matches('workspaces/' + resource.id + '/logo/[^/]+')));
    }

    match /workspaces/{wid} {
      allow read: if can(wid, 'workspace.read');
      // Pembuatan lewat createWorkspace (Cloud Function). ownerId, plan, isDemo, createdAt tidak bisa diubah client.
      allow create, delete: if false;
      allow update: if can(wid, 'workspace.update')
        && changedOnly(['name', 'businessName', 'industry', 'website', 'description', 'location',
                        'contactEmail', 'contactPhone', 'brandVoice', 'preferredLanguage',
                        'logoPath', 'logoUrl', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validWorkspaceProfile(request.resource.data);

      // Keanggotaan & role hanya diubah lewat Cloud Functions.
      match /members/{memberUid} {
        allow read: if can(wid, 'workspace.read');
        allow write: if false;
      }

      match /auditLogs/{logId} {
        allow read: if can(wid, 'audit.read');
        allow write: if false;
      }

      // ---------- Katalog (SPEC §6) — cermin offeringSchema di shared/schemas/catalog.ts ----------
      match /offerings/{offeringId} {
        allow read: if can(wid, 'workspace.read');
        allow create: if can(wid, 'catalog.manage') && validOffering(request.resource.data) && createdNow(request.resource.data);
        allow update: if can(wid, 'catalog.manage') && validOffering(request.resource.data) && createdUnchanged();
        allow delete: if can(wid, 'catalog.manage');
      }

      match /keywordGroups/{groupId} {
        allow read: if can(wid, 'workspace.read');
        allow create: if can(wid, 'catalog.manage') && validKeywordGroup(request.resource.data) && createdNow(request.resource.data);
        allow update: if can(wid, 'catalog.manage') && validKeywordGroup(request.resource.data) && createdUnchanged();
        allow delete: if can(wid, 'catalog.manage');
      }

      match /keywords/{keywordId} {
        allow read: if can(wid, 'workspace.read');
        allow create: if can(wid, 'catalog.manage') && validKeyword(request.resource.data) && createdNow(request.resource.data);
        allow update: if can(wid, 'catalog.manage') && validKeyword(request.resource.data) && createdUnchanged();
        allow delete: if can(wid, 'catalog.manage');
      }

      // ---------- Hasil AI (SPEC §9–§12): ditulis backend; client hanya status & teks draft ----------
      match /opportunities/{opportunityId} {
        allow read: if can(wid, 'workspace.read');
        allow update: if can(wid, 'reply.edit')
          && changedOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['new', 'saved', 'skipped']
          && stampedNow(request.resource.data);
        allow create, delete: if false;
      }

      match /replyDrafts/{draftId} {
        allow read: if can(wid, 'workspace.read');
        // Kualitas, gaya, dan status publikasi (approved/sending/sent/...) hanya dari backend.
        allow update: if can(wid, 'reply.edit')
          && changedOnly(['text', 'status', 'updatedAt', 'updatedBy'])
          && reqString(request.resource.data, 'text', 1, 300)
          && resource.data.status in ['draft', 'pending_approval', 'skipped']
          && request.resource.data.status in ['draft', 'pending_approval', 'skipped']
          && stampedNow(request.resource.data);
        allow create, delete: if false;
      }

      // ---------- Integrasi sosial (Fase 4): hanya backend yang menulis ----------
      // socialAccounts berisi metadata koneksi saja — token ada di integrationSecrets (ditolak penuh).
      match /socialAccounts/{accountId} {
        allow read: if can(wid, 'workspace.read');
        allow write: if false;
      }

      match /socialPosts/{postId} {
        allow read: if can(wid, 'workspace.read');
        allow write: if false;
      }

      match /monitoringRuns/{runId} {
        allow read: if can(wid, 'workspace.read');
        allow write: if false;
      }

      // Kuota & biaya AI: hanya backend yang menulis; Owner/Admin bisa melihat.
      match /usage/{usageId} {
        allow read: if can(wid, 'audit.read');
        allow write: if false;
      }

      // ---------- Pengaturan (SPEC §19) — hanya dokumen `automation` ----------
      match /settings/{settingsId} {
        allow read: if can(wid, 'workspace.read');
        allow create, update: if settingsId == 'automation'
          && can(wid, 'automation.manage')
          && validAutomation(request.resource.data);
        allow delete: if false;
      }
    }

    function validOffering(data) {
      return data.keys().hasOnly(['name', 'type', 'category', 'description', 'benefits', 'targetAudience',
                                  'problemsSolved', 'keywords', 'priceRange', 'usp', 'landingPageUrl',
                                  'allowedClaims', 'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && reqString(data, 'name', 2, 100)
        && data.type in ['service', 'product']
        && optString(data, 'category', 100)
        && optString(data, 'description', 1000)
        && optString(data, 'targetAudience', 300)
        && optString(data, 'priceRange', 100)
        && optString(data, 'usp', 300)
        && optList(data, 'benefits', 10)
        && optList(data, 'problemsSolved', 10)
        && optList(data, 'keywords', 20)
        && optList(data, 'allowedClaims', 10)
        && (!('landingPageUrl' in data) || data.landingPageUrl == ''
            || (data.landingPageUrl is string && data.landingPageUrl.size() <= 2048
                && data.landingPageUrl.matches('^https?://.+')))
        && data.isActive is bool
        && stampedNow(data);
    }

    function validKeywordGroup(data) {
      return data.keys().hasOnly(['name', 'offeringId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && reqString(data, 'name', 2, 60)
        && optIdOrNull(data, 'offeringId')
        && stampedNow(data);
    }

    function validKeyword(data) {
      return data.keys().hasOnly(['term', 'groupId', 'offeringId', 'isActive', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && reqString(data, 'term', 2, 100)
        && optIdOrNull(data, 'groupId')
        && optIdOrNull(data, 'offeringId')
        && data.isActive is bool
        && stampedNow(data);
    }

    // Cermin automationSettingsSchema di shared/schemas/automation.ts.
    function validAutomation(data) {
      return data.keys().hasOnly(['monitoringEnabled', 'monitoringIntervalMinutes', 'minOpportunityScore',
                                  'minMatchScore', 'defaultReplyStyle', 'manualApproval', 'dailyReplyLimit',
                                  'authorCooldownDays', 'duplicateDetection', 'notifyInApp', 'notifyEmail',
                                  'updatedAt', 'updatedBy'])
        && optBool(data, 'monitoringEnabled')
        && (!('monitoringIntervalMinutes' in data) || data.monitoringIntervalMinutes in [60, 120, 240, 720, 1440])
        && optInt(data, 'minOpportunityScore', 0, 100)
        && optInt(data, 'minMatchScore', 0, 100)
        && (!('defaultReplyStyle' in data)
            || data.defaultReplyStyle in ['friendly', 'professional', 'consultative', 'helpful', 'soft_selling'])
        // Tidak ada auto-reply: approval manual wajib (SPEC §19).
        && data.manualApproval == true
        && optInt(data, 'dailyReplyLimit', 1, 100)
        && optInt(data, 'authorCooldownDays', 1, 30)
        && optBool(data, 'duplicateDetection')
        && optBool(data, 'notifyInApp')
        && optBool(data, 'notifyEmail')
        && stampedNow(data);
    }

    // Collection group: daftar workspace milik pengguna (workspace switcher).
    match /{path=**}/members/{memberUid} {
      allow read: if verified() && resource.data.uid == request.auth.uid;
    }

    // ---------- invitations/{inviteId} ----------
    match /invitations/{inviteId} {
      allow read: if verified() && (
        resource.data.email == request.auth.token.email.lower()
        || can(resource.data.workspaceId, 'members.manage')
      );
      allow write: if false;
    }

    // Token OAuth terenkripsi, state OAuth, dan catatan penghapusan data — tidak pernah untuk client.
    match /integrationSecrets/{secretId} {
      allow read, write: if false;
    }
    match /oauthStates/{state} {
      allow read, write: if false;
    }
    match /dataDeletionRequests/{code} {
      allow read, write: if false;
    }

    // Antrean email (Firebase Extension "Trigger Email") — backend-only.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Semua path lain: ditolak (default).
  }
}
