rules_version = '2';

// Fase 0: tolak semua akses client. Aturan per koleksi ditambahkan mulai Fase 1 (SPEC §15).
// Admin SDK (Cloud Functions) tidak terikat rules ini.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
