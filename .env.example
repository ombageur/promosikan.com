# Salin ke .env.local (development) atau .env.production. Semua VITE_* masuk ke bundle browser = PUBLIK.
# JANGAN pernah menaruh secret (OpenAI, Threads app secret, dll.) di variabel VITE_*.

# true = pakai Firebase Emulator Suite (project demo-promosikan); variabel Firebase di bawah diabaikan.
VITE_USE_EMULATORS=true

# Konfigurasi web app: Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=promosikan-com.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=promosikan-com
VITE_FIREBASE_STORAGE_BUCKET=promosikan-com.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsional: site key reCAPTCHA Enterprise untuk App Check (kosong = App Check tidak aktif).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Secret backend TIDAK di sini. Simpan di Secret Manager, contoh:
#   npx firebase functions:secrets:set OPENAI_API_KEY
# Secret yang direncanakan: OPENAI_API_KEY, THREADS_APP_ID, THREADS_APP_SECRET, TOKEN_ENCRYPTION_KEY
